{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beersheba-songs",
  "account_id": "60a94fcc1420a35fb393626809b90bb2",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beersheba-songs",
      "database_id": "6c6ac59a-3ef2-4a91-bd2f-92c71d32c0ce",
      "migrations_dir": "drizzle"
    }
  ],
  "routes": [
    {
      "pattern": "songs.beersheba.cc",
      "custom_domain": true
    }
  ]
}
